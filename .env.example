# =============================================================================
# Tower Defense - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-tower-defense-local-secret-key-change-in-prod
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
# Local machine via mapped port 5433:
DATABASE_URL=postgres://tower:defense_password@localhost:5433/tower_defense_db
# Docker compose internal network:
# DATABASE_URL=postgres://tower:defense_password@postgres:5432/tower_defense_db

# Redis Channels Layer & Cache
# Local machine via mapped port 6380:
REDIS_URL=redis://localhost:6380/0
# Docker compose internal network:
# REDIS_URL=redis://redis:6379/0

# CORS & CSRF Security Policies
CORS_ALLOW_ALL_ORIGINS=True
# In Production (DEBUG=False), set specific origins:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:80,https://yourdomain.com

# Static Files & HTTPS (Production)
COLLECT_STATIC=0
ENABLE_HTTPS=false

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
