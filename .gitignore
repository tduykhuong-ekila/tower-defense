# Local environment variables (keep example files).
.env
.env.*
!.env.example
!.env.*.example

# Python environments, bytecode, and tool caches.
.venv/
venv/
backend/env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Test coverage reports.
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/

# Disposable local arena data and generated preview credentials.
backend/.local/
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
backend/staticfiles/

# Frontend dependencies, builds, and caches.
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Local logs and operating-system files.
*.log
.DS_Store
Thumbs.db
