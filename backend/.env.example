DEBUG=True
SECRET_KEY=django-insecure-tower-defense-local-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Mặc định local dev: dùng sqlite nếu chưa bật postgres, hoặc postgres theo URL
DATABASE_URL=postgres://tower:defense@localhost:5433/tower_defense_db

# Redis
REDIS_URL=redis://localhost:6380/0

# CORS
CORS_ALLOW_ALL_ORIGINS=True
